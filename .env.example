# Copy to .env and fill in. Every mode defaults to its safe offline value,
# and live modes fall back automatically if anything fails.
# All of these are server-side only — never prefix with NEXT_PUBLIC_.

# Signs payment quotes. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Payments: mock | interledger -------------------------------------------
PAYMENTS_MODE=mock

# Interledger test network (https://wallet.interledger-test.dev)
# 1. Create a test wallet account, then a wallet address (e.g. USD).
# 2. In Developer keys, generate a key pair; download the private key.
# 3. Fill these in, then run `npm run setup-grant` once to approve sending.
OP_CLIENT_WALLET_ADDRESS=https://ilp.interledger-test.dev/your-wallet
OP_KEY_ID=
# Path to the downloaded private.key (preferred locally) …
OP_PRIVATE_KEY_PATH=./private.key
# … or the key itself (PEM with \n, or the base64 blob) for Vercel.
OP_PRIVATE_KEY=
# Wallet that money is sent from (defaults to the client wallet).
OP_SENDER_WALLET_ADDRESS=
# Written by `npm run setup-grant` to .data/grant.json; set these on Vercel.
OP_OUTGOING_ACCESS_TOKEN=
OP_OUTGOING_MANAGE_URL=
# Optional: real test-network wallets for the demo contacts (Ana, Mom).
OP_DEMO_ROOMMATE_WALLET=
OP_DEMO_FAMILY_WALLET=
OP_DEMO_FRIEND_WALLET=

# ---- AI lessons and coach: mock | live --------------------------------------
AI_MODE=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ---- Market data: snapshot | live ------------------------------------------
MARKET_MODE=snapshot
FINNHUB_API_KEY=
