# Copy to .env and fill in. Every mode defaults to its safe offline value.
# All of these are server-side only — never prefix with NEXT_PUBLIC_.

# Signs payment quotes. Required in production: use a long random string
# (e.g. `openssl rand -base64 48`).
SESSION_SECRET=change-me-to-a-long-random-string

# Public URL of the app. Wallets send people back here after they approve
# Sprout, e.g. https://sprout.vercel.app. Optional locally.
APP_URL=

# ---- Accounts & storage -----------------------------------------------------
# Accounts, sessions and app data. Required on Vercel (serverless instances
# don't share disk). Locally, leave empty to use files in .data/kv.
# Upstash Redis (free tier works), or Vercel KV which sets these for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Payments: mock | interledger -------------------------------------------
PAYMENTS_MODE=mock

# Sprout's own Open Payments client identity on the Interledger test network
# (https://wallet.interledger-test.dev). People connect their own wallets in
# the app and approve Sprout there; no per-person secrets go in this file.
# 1. Create a test wallet account and a wallet address for Sprout itself.
# 2. In Developer keys, generate a key pair and download the private key.
OP_CLIENT_WALLET_ADDRESS=https://ilp.interledger-test.dev/your-sprout-client
OP_KEY_ID=
# Path to the downloaded private.key (preferred locally) …
OP_PRIVATE_KEY_PATH=./private.key
# … or the key itself (PEM with \n, or the base64 blob) for Vercel.
OP_PRIVATE_KEY=

# ---- AI lessons and coach: mock | live --------------------------------------
AI_MODE=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ---- Market data: snapshot | live ------------------------------------------
MARKET_MODE=snapshot
FINNHUB_API_KEY=
